rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---- review_cards shape validation (Japanese Reader v0.4, P4.3) ----------

    // The exact field set of a ReviewCard (see
    // japanese-alchemy-webapp/lib/reviewCard.ts).
    function reviewCardFieldNames() {
      return [
        'id', 'userId', 'lexicalKey', 'type', 'state', 'dueAt', 'intervalDays',
        'reps', 'lapses', 'lastRating', 'lastReviewedAt', 'createdAt',
        'updatedAt', 'surface', 'reading', 'meaning', 'sourceSentence',
        'sourceUrl', 'sourceAnalysisId', 'sourceLearningItemId'
      ];
    }

    // A whole, non-negative number. The Firestore Web SDK has no integer type —
    // every JS number is stored as a double — so `is int` would reject every
    // client write. We check `is number` + non-negative + no fractional part.
    function isWholeNonNegative(n) {
      return n is number && n >= 0 && n == math.floor(n);
    }

    // `d` is a full document (create ⇒ the new doc; update ⇒ the merged result).
    function isValidReviewCard(d, userId, cardId) {
      return d.keys().hasOnly(reviewCardFieldNames())
        && d.keys().hasAll(reviewCardFieldNames())
        && d.id == cardId
        && d.userId == userId
        && d.lexicalKey is string && d.lexicalKey.size() > 0
        && d.type in ['vocab', 'grammar']
        && d.state in ['learning', 'review']
        && d.dueAt is number
        && isWholeNonNegative(d.intervalDays)
        && isWholeNonNegative(d.reps)
        && isWholeNonNegative(d.lapses)
        && (d.lastRating == null || d.lastRating in [1, 3, 4])
        && (d.lastReviewedAt == null || d.lastReviewedAt is number)
        && d.createdAt is number
        && d.updatedAt is number
        && d.surface is string
        && (d.reading == null || d.reading is string)
        && (d.meaning == null || d.meaning is string)
        && d.sourceSentence is string
        && (d.sourceUrl == null || d.sourceUrl is string)
        && d.sourceAnalysisId is string
        && d.sourceLearningItemId is string;
    }

    // Only the eight scheduling fields may change on an update.
    function reviewCardImmutableFieldsUnchanged(before, after) {
      return after.id == before.id
        && after.userId == before.userId
        && after.lexicalKey == before.lexicalKey
        && after.type == before.type
        && after.surface == before.surface
        && after.reading == before.reading
        && after.meaning == before.meaning
        && after.sourceSentence == before.sourceSentence
        && after.sourceUrl == before.sourceUrl
        && after.sourceAnalysisId == before.sourceAnalysisId
        && after.sourceLearningItemId == before.sourceLearningItemId
        && after.createdAt == before.createdAt;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // The owner may READ any document anywhere in their own subtree
      // (forward-compatible). Writes are granted per-collection below, so an
      // undeclared future subcollection is read-only by default.
      match /{document=**} {
        allow read: if isOwner(userId);
      }

      // Snapshot subcollections — unchanged v0.2–v0.4 behaviour: full owner
      // write. Cloud Functions write vocabularies / grammars / learning_items
      // via the Admin SDK (rules bypassed); the webapp client only reads them
      // and deletes analysis_pages.
      match /vocabularies/{docId}   { allow write: if isOwner(userId); }
      match /grammars/{docId}       { allow write: if isOwner(userId); }
      match /analysis_pages/{docId} { allow write: if isOwner(userId); }
      match /learning_items/{docId} { allow write: if isOwner(userId); }

      // review_cards (Japanese Reader v0.4): owner-only, shape-validated,
      // schedule-only updates, no client delete (there is no remove-from-review
      // UX). The Admin SDK is never used for review_cards.
      match /review_cards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidReviewCard(request.resource.data, userId, cardId);
        allow update: if isOwner(userId)
          && isValidReviewCard(request.resource.data, userId, cardId)
          && reviewCardImmutableFieldsUnchanged(resource.data, request.resource.data);
        allow delete: if false;
      }
    }

    // Root-level vocabularies collection
    match /vocabularies/{vocabularyId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Root-level grammars collection
    match /grammars/{grammarId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Shared analysis pages are published by the Admin SDK and browseable by
    // anyone. Clients never write or delete shared pages.
    match /shared_analysis_pages/{pageId} {
      allow read: if true;
    }

    // Shared vocabularies are published by the Admin SDK and browseable by
    // anyone. Clients never write or delete shared items.
    match /shared_vocabularies/{docId} {
      allow read: if true;
    }

    // Shared grammars are published by the Admin SDK and browseable by
    // anyone. Clients never write or delete shared items.
    match /shared_grammars/{docId} {
      allow read: if true;
    }

    // Rate-limit counters: written only by the Admin SDK (Cloud Functions).
    // Explicitly deny client reads/writes as defense-in-depth against future
    // rule drift (the Admin SDK bypasses rules, but that is safety-by-default).
    match /rateLimits/{document=**} {
      allow read, write: if false;
    }
  }
}
